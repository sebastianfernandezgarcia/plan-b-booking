# Copy locally to .env. Never place credentials in public source or screenshots.
# demo: offline payment simulation. sandbox: real sandbox calls, never live payments.
PAYMENT_MODE=demo
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# rules-preview is deterministic, not AI. ollama requires a model already installed locally.
PLANNER_MODE=rules-preview
OLLAMA_MODEL=
PORT=4320
